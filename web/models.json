{
 "_doc": [
  "UI のタブ（tasks）とモデル（models）の定義。ブラウザ（web/）とサーバー（adapters.py）が読む。書き方は docs/ADDING_MODELS.md と docs/ADDING_UI.md"
 ],
 "categories": [
  {
   "id": "detect",
   "name": "検出・追跡"
  },
  {
   "id": "seg",
   "name": "セグメンテーション"
  },
  {
   "id": "3d",
   "name": "深度・3D"
  },
  {
   "id": "vl",
   "name": "画像と言語"
  }
 ],
 "tasks": [
  {
   "id": "detect",
   "name": "物体検出",
   "hint": "COCO 80クラス。閾値で絞る。動画・カメラでは追跡（ID 付け）もできる",
   "params": [
    "threshold",
    "track"
   ],
   "defaults": {
    "threshold": 0.4
   },
   "category": "detect"
  },
  {
   "id": "pose",
   "name": "人物の姿勢",
   "hint": "17関節（COCO）。動画・カメラでは追跡（ID 付け）もできる",
   "params": [
    "threshold",
    "track"
   ],
   "defaults": {
    "threshold": 0.4
   },
   "category": "detect"
  },
  {
   "id": "wholebody",
   "name": "手・目（PINTO）",
   "hint": "PINTO の超軽量モデル。体・頭・顔・目・手を検出し、目の開閉・指差し・手を振る動作を小さな分類モデルで判定する。手を振るは動画・カメラで追跡を選んだ時だけ",
   "params": [
    "threshold",
    "track",
    "cascade"
   ],
   "defaults": {
    "threshold": 0.35
   },
   "category": "detect"
  },
  {
   "id": "zsdetect",
   "name": "テキスト物体検知",
   "hint": "英語の名詞をカンマ区切り（例: cat, remote control）",
   "params": [
    "labels",
    "threshold",
    "track"
   ],
   "defaults": {
    "threshold": 0.3,
    "labels": "person, bus, bag"
   },
   "category": "detect"
  },
  {
   "id": "segment",
   "name": "プロンプト（SAM）",
   "hint": "クリックした場所の物体を切り出す（プロンプト型のセグメンテーション）。除く点は Shift＋クリックかチェックで。「全体を自動分割」は格子状の点から画面全体を物体ごとに塗り分ける（クラス名は付かない。ブラウザのみ）",
   "params": [
    "points"
   ],
   "click": true,
   "category": "seg"
  },
  {
   "id": "semantic",
   "name": "セマンティック",
   "category": "seg",
   "hint": "画素ごとにクラスを塗り分ける（ADE20K の 150 クラス。道路・建物・空・人など）。同じクラスの物は1つの領域になる",
   "params": []
  },
  {
   "id": "panoptic",
   "name": "パノプティック",
   "category": "seg",
   "hint": "数えられる物（人・車など）は1つずつ、数えられない領域（道路・空など）はまとめて塗り分ける（COCO の 133 クラス）",
   "params": []
  },
  {
   "id": "depth",
   "name": "深度推定",
   "hint": "赤いほど近い（相対深度）",
   "params": [],
   "category": "3d"
  },
  {
   "id": "classify",
   "name": "ゼロショット分類",
   "hint": "候補をカンマ区切り（英語）。棒は候補間の相対値、括弧内はモデルの絶対スコア",
   "params": [
    "labels"
   ],
   "defaults": {
    "labels": "bus, truck, tram, street, office, cat"
   },
   "category": "vl"
  },
  {
   "id": "matting",
   "name": "背景除去",
   "hint": "前景だけを残す",
   "params": [],
   "category": "seg"
  },
  {
   "id": "vlm",
   "name": "画像の説明・質問",
   "hint": "SmolVLM は英語のみ。日本語は Qwen",
   "params": [
    "prompt"
   ],
   "defaults": {
    "prompt": "この画像を日本語で詳しく説明してください。"
   },
   "category": "vl"
  }
 ],
